/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickpic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-10",

  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    {
      "pattern": "pickpic.photos",
      "custom_domain": true,
    },
  ],

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickpic-db",
      "database_id": "d31cb43a-46d6-478c-b0cd-81e3df2f0d94",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "pickpic-photos",
      "binding": "pickpic_photos",
    },
  ],
  "env": {
    "admin": {
      "routes": [
        {
          "pattern": "admin.pickpic.photos",
          "custom_domain": true,
        },
      ],

      "vars": {
        "TEAM_DOMAIN": "https://pickpic.cloudflareaccess.com",
        "POLICY_AUD": "7c33bafb500ce92d07e4846bd77d998f8a1b7b7bca308c46057deb0c82e57ed5",
      },

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pickpic-db",
          "database_id": "d31cb43a-46d6-478c-b0cd-81e3df2f0d94",
        },
      ],

      "r2_buckets": [
        {
          "bucket_name": "pickpic-photos",
          "binding": "pickpic_photos",
        },
      ],
    },

    "app": {
      "routes": [
        {
          "pattern": "app.pickpic.photos",
          "custom_domain": true,
        },
      ],

      "vars": {
        "AUTH_MODE": "session",
        "MAGIC_LINK_FROM": "PickPic <login@pickpic.photos>",

        // The Services ID registered for Sign in with Apple, and the Return URL
        // registered on it. Vars rather than secrets on purpose: the client id
        // travels in the query string of every authorize redirect and the
        // return URL is registered publicly with Apple, so neither is secret,
        // and a wrong value in either is a configuration bug worth seeing in a
        // diff. The team id, key id and private key are secrets --
        // `wrangler secret put APPLE_TEAM_ID --env app`, and likewise
        // APPLE_KEY_ID and APPLE_PRIVATE_KEY.
        "APPLE_CLIENT_ID": "photos.pickpic.signin",
        "APPLE_REDIRECT_URI": "https://app.pickpic.photos/api/auth/apple/callback",
      },

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pickpic-db",
          "database_id": "d31cb43a-46d6-478c-b0cd-81e3df2f0d94",
        },
      ],

      "r2_buckets": [
        {
          "bucket_name": "pickpic-photos",
          "binding": "pickpic_photos",
        },
      ],
    },
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
