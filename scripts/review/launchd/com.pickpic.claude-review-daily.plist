<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pickpic.claude-review-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/patrick/Dev/pickpic/scripts/review/run-review.sh</string>
        <string>daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/patrick/Dev/pickpic</string>

    <!-- Mon-Thu at 6:10am. Patrick sleeps ~04:00-11:00, so this has a ~4.8h runway before he is
         awake and competing for the same budget window. Friday and Saturday belong to the
         surplus agent instead. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>10</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/patrick/Library/Logs/claude-review-daily.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/patrick/Library/Logs/claude-review-daily.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/patrick/.local/bin:/Users/patrick/.nvm/versions/node/v26.5.1/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
