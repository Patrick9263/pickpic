# Copy to .dev.vars (git-ignored) to configure `npm run dev`.
#
# Note that `npx wrangler dev` serves the last `npm run build` output rather than
# live sources, so use `npm run dev` when testing worker changes.
#
# This file is read once at startup. Editing it while the dev server is running
# changes nothing until the server is restarted -- which looks exactly like the
# code ignoring the setting.

# Which guard stands in front of /api/admin/*.
#
#   access  -- Cloudflare Access, as on admin.pickpic.photos. This is also the
#              default when AUTH_MODE is unset, and on localhost it is a no-op,
#              so admin routes are simply open.
#   session -- one of our own session cookies, as app.pickpic.photos will use.
#              Set this to exercise the magic-link sign-in flow locally.
#
# Any other value is refused outright: a typo must fail closed.
AUTH_MODE=session

# Transactional sender for every email this worker sends. Leave unset in
# development and the link is printed to the worker console instead of being
# emailed -- a fallback that only ever applies to a request that arrived on
# localhost.
#
# In production this is a secret (`wrangler secret put RESEND_API_KEY`), never a
# var in wrangler.jsonc -- and it is needed on ALL THREE deployments, not just
# the one serving /api/auth/*. Gallery mail (#224) is sent by the public worker
# when a viewer requests a RAW, and by the admin/app worker when the iPad
# delivers one, so `wrangler secret put RESEND_API_KEY` has to be run for the
# default and admin environments as well as app.
#
# A missing key is fatal for sign-in mail and deliberately not fatal for gallery
# mail: a RAW that uploaded successfully must never be reported as a failed
# upload because the notification bounced.
# RESEND_API_KEY=re_...

# Must be an address on a domain verified with Resend, or every send is
# rejected. Defaults to "PickPic <login@pickpic.photos>".
# MAGIC_LINK_FROM=PickPic <login@pickpic.photos>

# The sender for gallery mail -- RAW request confirmations and delivery links.
# Defaults to "PickPic <photos@pickpic.photos>", which is why it is not set in
# wrangler.jsonc for any of the three deployments.
#
# Separate from MAGIC_LINK_FROM on purpose, and worth keeping that way: this
# mail goes to event guests who never asked for a PickPic account and may well
# mark it as spam, while sign-in deliverability is load-bearing for every
# customer. Same verified domain, so a new address here needs no Resend setup.
# RAW_DELIVERY_FROM=PickPic <photos@pickpic.photos>

# The single shared code /api/auth/signup requires, and the whole of its access
# control. Signing up is the one unauthenticated way to create an account, and
# there is no billing yet, so an open form would let a stranger fill the R2
# bucket at our expense.
#
# Unset switches signup off entirely rather than opening it: both endpoints
# answer 503 and no account can be created. That is the intended state for every
# deployment except app.pickpic.photos, which is why this is a secret rather than
# a var in wrangler.jsonc -- `wrangler secret put SIGNUP_INVITE_CODE --env app`.
#
# Rotating it is the entire revocation story: changing the value invalidates
# every code handed out before and every confirmation link still in flight.
#
# Set rather than commented out, unlike RESEND_API_KEY, because there is no
# console fallback here -- leaving it unset means signup cannot be exercised
# locally at all.
SIGNUP_INVITE_CODE=local-dev-invite

# Sign in with Apple. All five values come from the Apple Developer portal:
# APPLE_TEAM_ID from Membership details, APPLE_CLIENT_ID from the Services ID
# registered for Sign in with Apple, and APPLE_KEY_ID plus APPLE_PRIVATE_KEY
# from the key created for it -- the private key being the .p8 file's contents,
# which Apple lets you download exactly once.
#
# APPLE_REDIRECT_URI must byte-for-byte match a Return URL registered on that
# Services ID. It cannot be derived from the incoming request the way a
# magic-link URL is, and Apple rejects http:// and localhost outright, so
# exercising this locally means putting an https tunnel in front of the dev
# server and registering the tunnel's URL alongside the production one.
#
# In production the last three are secrets (`wrangler secret put APPLE_TEAM_ID
# --env app`, and likewise for the other two) while APPLE_CLIENT_ID and
# APPLE_REDIRECT_URI are vars in wrangler.jsonc.
#
# Leaving any of them unset answers 503 on /api/auth/apple/start rather than
# sending somebody to Apple for a sign-in this deployment could not finish.
# APPLE_TEAM_ID=
# APPLE_CLIENT_ID=photos.pickpic.signin
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
# APPLE_REDIRECT_URI=https://your-tunnel.example/api/auth/apple/callback
